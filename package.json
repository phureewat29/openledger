{
  "name": "@aquartier/openledger",
  "version": "0.27.0",
  "description": "OpenLedger — A deterministic ledger for your AI",
  "keywords": [
    "finance",
    "harness",
    "personal",
    "ledger",
    "bookkeeping",
    "cli",
    "ai"
  ],
  "homepage": "https://openledger.sh",
  "bugs": {
    "url": "https://github.com/phureewat29/openledger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phureewat29/openledger.git"
  },
  "license": "MIT",
  "author": "Phureewat A",
  "type": "module",
  "bin": {
    "oled": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "models/",
    "skills/",
    "datasets/",
    "plugin.json"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --typecheck --typecheck.tsconfig ./tsconfig.typecheck.json",
    "dev": "tsx src/cli/index.ts",
    "release": "tsx scripts/release.ts",
    "publish:skills": "tsx scripts/publish-skills.ts",
    "integration": "vitest run -c vitest.e2e.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "es-toolkit": "^1.53.2",
    "libsql": "^0.5.29",
    "mupdf": "^1.28.6",
    "onnxruntime-web": "1.31.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws4fetch": "^1.0.20",
    "dotenv": "^18.0.10",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
